#!/usr/bin/env bash
# ag/ship: build, gate, preflight, deploy and push one commit of this fork to the T3 server on Ag's session host.
# The one command a feature agent runs after committing (FORK.md). Safe to run any time: if any step fails, the
# running server is untouched (or rolled back) and nothing is pushed.
#
#   ag/ship [<rev>]        default HEAD of the current checkout. Builds that exact commit in a clean worktree.
#     --no-push            deploy without pushing (bootstrap, experiments)
#     --no-tests           skip the affected-tests gate (typecheck still runs)
#     --base <rev>         what "affected" is measured against (default: the commit now deployed)
#     --no-mac             don't rebuild the Mac app (ag/build-mac) after pushing
#   ag/ship --rollback     go back to the previously deployed build
#   ag/ship --status       what's deployed, and the last few ships
#
# Steps: worktree at <rev> → pnpm install → version-stamp + build (web bundled into the server) → typecheck →
# vitest --changed <base> → preflight (the candidate boots on a spare port against a backup copy of the live T3
# database, so migrations run on real data first) → switch the `current` symlink, restart ag-t3.service,
# health-check, roll back on failure → push <rev> to origin/main (fast-forward only) → prune old builds.
set -euo pipefail
REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# Run from a worktree of this repo (e.g. ~/t3code-<topic>), ship that worktree's HEAD, not the main checkout's.
common() { git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null; }
top=$(git rev-parse --show-toplevel 2>/dev/null || true)
[[ -n $top && $(common "$top") == "$(common "$REPO")" ]] && REPO=$top
BUILDS=${T3_BUILDS:-$HOME/.local/share/t3-builds}
LIVE=${T3_HOME:-$HOME/.t3}
UNIT=ag-t3.service
PORT=3773 STAGE_PORT=3779
LOG=$BUILDS/ship.jsonl
KEEP=4
mkdir -p "$BUILDS"
say() { printf '\033[1m▸ %s\033[0m\n' "$*" >&2; }
die() { printf '\033[31mship: %s\033[0m\n' "$*" >&2; record fail "$*"; exit 1; }
record() { printf '{"ts":"%s","sha":"%s","result":"%s","note":%s}\n' "$(date -u +%FT%TZ)" "${SHA:-}" "$1" "$(jq -Rn --arg s "${2:-}" '$s')" >>"$LOG"; }
deployed() { basename "$(readlink -f "$BUILDS/current" 2>/dev/null)" 2>/dev/null || true; }
healthy() { # $1 port, $2 expected version substring
	for _ in $(seq 60); do
		v=$(curl -fsS -m 3 "http://127.0.0.1:$1/.well-known/t3/environment" 2>/dev/null | jq -r '.serverVersion // empty' 2>/dev/null || true)
		[[ -n $v && $v == *"$2"* ]] && return 0
		sleep 2
	done
	return 1
}
install_cli() { # ~/.local/bin/t3 runs the deployed build, so `t3 pair`/`auth`/`project` always match the server's schema.
	mkdir -p "$HOME/.local/bin"
	rm -f "$HOME/.local/bin/t3"
	cat >"$HOME/.local/bin/t3" <<EOF
#!/bin/sh
# Generated by ag/ship (koerschner/t3code): the deployed fork build's CLI.
exec node "$BUILDS/current/apps/server/dist/bin.mjs" "\$@"
EOF
	chmod +x "$HOME/.local/bin/t3"
}
switch_to() { # $1 build dir name → current, restart, health-check
	ln -sfn "$BUILDS/$1" "$BUILDS/current.new" && mv -T "$BUILDS/current.new" "$BUILDS/current"
	install_cli
	systemctl --user daemon-reload
	systemctl --user restart "$UNIT"
	healthy $PORT "$(cat "$BUILDS/$1/.version")"
}

# Turns run inside the server (Pi under ag-t3.service), so a restart cancels every running turn, and T3 then holds
# that thread's queued messages instead of sending them. Deploys therefore restart only once no turn is running.
busy() {
	sqlite3 -readonly "$LIVE/userdata/statev2.sqlite" \
		"select count(*) from orchestration_v2_projection_runs where status in ('preparing','starting','running','waiting')" 2>/dev/null | grep -qv '^0$'
}
deploy_now() { # $1 new build, $2 current build (rollback target)
	[[ -n $2 && $2 != "$1" ]] && echo "$2" >"$BUILDS/previous"
	switch_to "$1" && return 0
	journalctl --user -u "$UNIT" -n 40 --no-pager >&2 || true
	if [[ -n $2 ]]; then say "unhealthy: rolling back to $2"; switch_to "$2" || true; fi
	return 1
}

case ${1:-} in
--deploy-when-idle) # internal: $2 build, $3 rollback target. Waits up to 3h for turns to finish, then restarts.
	SHA=$2
	for _ in $(seq 2160); do busy || break; sleep 5; done
	exec 9>"$BUILDS/.lock"; flock 9
	[[ $(cat "$BUILDS/pending" 2>/dev/null) == "$2" ]] || exit 0 # a newer ship replaced this one
	rm -f "$BUILDS/pending"
	if deploy_now "$2" "${3:-}"; then record ok "deployed when idle: $(cat "$BUILDS/$2/.version")"; else record fail "deploy when idle: unhealthy, rolled back to ${3:-nothing}"; fi
	exit 0 ;;
--status)
	echo "deployed: $(deployed) ($(cat "$BUILDS/current/.version" 2>/dev/null))"
	[[ -f $BUILDS/pending ]] && echo "pending (restarts when no turn is running): $(cat "$BUILDS/pending")"
	tail -n 5 "$LOG" 2>/dev/null || true
	exit 0 ;;
--rollback)
	prev=$(cat "$BUILDS/previous" 2>/dev/null) || { echo "no previous build" >&2; exit 1; }
	SHA=$prev; say "rolling back to $prev"
	cur=$(deployed); switch_to "$prev" && { echo "$cur" >"$BUILDS/previous"; record rollback "from $cur"; echo "rolled back to $prev"; exit 0; }
	die "rollback target $prev is unhealthy too" ;;
esac

PUSH=1 TESTS=1 MAC=1 BASE="" REV=HEAD
while (($#)); do case $1 in
	--no-push) PUSH=0 ;; --no-tests) TESTS=0 ;; --no-mac) MAC=0 ;; --base) BASE=$2; shift ;;
	-*) sed -n '2,14p' "$0"; exit 2 ;; *) REV=$1 ;;
esac; shift; done

cd "$REPO"
[[ -z $(git status --porcelain --untracked-files=no) || $REV != HEAD ]] || say "note: uncommitted changes are not shipped; only commit $(git rev-parse --short HEAD)"
SHA=$(git rev-parse "$REV^{commit}")
SHORT=${SHA:0:10}
CUR=$(deployed)
BASE=${BASE:-$CUR}
git cat-file -e "${BASE:-x}^{commit}" 2>/dev/null || BASE=$(git merge-base "$SHA" upstream/main 2>/dev/null || git rev-parse "$SHA~1")
DIR=$BUILDS/$SHORT
exec 9>"$BUILDS/.lock"; flock -n 9 || die "another ship is running"

# 1. Build (reused if this commit was built before).
if [[ ! -f $DIR/.built ]]; then
	say "build $SHORT in $DIR"
	rm -rf "$DIR"; git worktree prune
	git worktree add --detach "$DIR" "$SHA" >/dev/null
	cd "$DIR"
	corepack pnpm install --frozen-lockfile --prefer-offline >"$DIR/.install.log" 2>&1 || die "pnpm install failed (see $DIR/.install.log)"
	# The server's browser tests need the headless Chromium matching this build's playwright-core (upstream bumps it).
	pw=$(ls -d node_modules/.pnpm/playwright-core@*/node_modules/playwright-core 2>/dev/null | tail -1)
	[ -n "$pw" ] && node "$pw/cli.js" install chromium-headless-shell >>"$DIR/.install.log" 2>&1 || true
	# Same core as upstream nightlies (package.json patch + 1, scripts/resolve-nightly-release.ts): nightly desktop
	# and iOS clients compare cores against a non-nightly server, so an unbumped core reads as "server behind".
	core=$(jq -r '.version | sub("[-+].*$"; "") | split(".") | .[2] = ((.[2] | tonumber) + 1 | tostring) | join(".")' apps/server/package.json)
	ver="$core-ag.$(git log -1 --format=%cd --date=format:%Y%m%d "$SHA").$SHORT"
	jq --arg v "$ver" '.version = $v' apps/server/package.json >/tmp/pkg.$$ && mv /tmp/pkg.$$ apps/server/package.json
	echo "$ver" >.version
	node_modules/.bin/vp run --filter t3 build >"$DIR/.build.log" 2>&1 || die "build failed (see $DIR/.build.log)"
	touch .built
fi
cd "$DIR"
VER=$(cat .version)

# 2. Gates.
say "typecheck"
node_modules/.bin/vp run --filter t3 --filter @t3tools/web --filter @t3tools/contracts --filter @t3tools/client-runtime --filter @t3tools/shared typecheck >.typecheck.log 2>&1 || { tail -40 .typecheck.log >&2; die "typecheck failed"; }
if ((TESTS)); then
	# Each changed package runs its own vitest config, limited to tests affected by the change.
	# Only what the server ships (FORK.md "Surfaces"): the desktop, mobile and marketing apps aren't deployed here,
	# and the desktop tests need an Electron binary the headless host doesn't have.
	pkgs=$(git diff --name-only "$BASE" "$SHA" | grep -oE '^(apps/(server|web)|packages/[^/]+)' | sort -u | while read -r p; do [[ -f $p/package.json ]] && jq -e '.scripts.test' "$p/package.json" >/dev/null && echo "$p"; done || true)
	say "tests affected since ${BASE:0:10} in: ${pkgs:-nothing}"
	: >.test.log
	for p in $pkgs; do
		(cd "$p" && "$DIR/node_modules/.bin/vp" test run --changed "$BASE" --passWithNoTests) >>.test.log 2>&1 || { tail -60 .test.log >&2; die "tests failed in $p"; }
	done
fi

# 3. Preflight: boot the candidate against a backup of the live database.
say "preflight on :$STAGE_PORT with a copy of the live database"
STAGE=$(mktemp -d /tmp/t3-preflight.XXXX)
mkdir -p "$STAGE/userdata"
# server-owner.sqlite is upstream's ownership lock: empty, and held in an exclusive transaction by the live server.
# A busy timeout rides out the live server's brief write locks instead of failing the backup.
for db in "$LIVE"/userdata/*.sqlite; do
	[[ $(basename "$db") == server-owner.sqlite ]] && continue
	sqlite3 -cmd '.timeout 60000' "$db" ".backup '$STAGE/userdata/$(basename "$db")'"
done
cp "$LIVE/userdata/settings.json" "$STAGE/userdata/" 2>/dev/null || true
node apps/server/dist/bin.mjs serve --host 127.0.0.1 --port $STAGE_PORT --no-browser --base-dir "$STAGE" "$HOME" >"$DIR/.preflight.log" 2>&1 &
pf=$!
ok=0; healthy $STAGE_PORT "$VER" && ok=1
kill "$pf" 2>/dev/null; wait "$pf" 2>/dev/null || true
rm -rf "$STAGE"
((ok)) || { tail -30 "$DIR/.preflight.log" >&2; die "candidate didn't come up on a copy of the live data"; }

# 4. Deploy, with rollback.
if [[ $CUR == "$SHORT" ]]; then
	say "$SHORT is already deployed"
else
	if busy; then
		say "turns are running: $VER restarts in when they finish (ag/ship --status shows it)"
		echo "$SHORT" >"$BUILDS/pending"
		setsid nohup "$REPO/ag/ship" --deploy-when-idle "$SHORT" "$CUR" >>"$BUILDS/deploy-when-idle.log" 2>&1 </dev/null 9>&- &
	else
		say "deploy $VER"
		rm -f "$BUILDS/pending"
		deploy_now "$SHORT" "$CUR" || die "deployed build didn't come up healthy (rolled back to ${CUR:-nothing})"
	fi
fi

# 5. Push (fast-forward only), then prune old builds.
if ((PUSH)); then
	say "push $SHORT → origin/main"
	cd "$REPO"; git fetch -q origin main
	git merge-base --is-ancestor origin/main "$SHA" || die "deployed, but $SHORT doesn't fast-forward origin/main: merge origin/main, then ship again"
	git push -q origin "$SHA:refs/heads/main" || die "deployed, but the push failed"
fi
cd "$REPO"
for old in $(ls -1t "$BUILDS" | grep -E '^[0-9a-f]{10}$' | tail -n +$((KEEP + 1))); do
	[[ $old == "$(deployed)" || $old == "$(cat "$BUILDS/previous" 2>/dev/null)" || $old == "$(cat "$BUILDS/pending" 2>/dev/null)" ]] && continue
	git worktree remove --force "$BUILDS/$old" 2>/dev/null || rm -rf "${BUILDS:?}/$old"
done
git worktree prune
record ok "$VER"
# 6. The Mac app bundles its own web UI (FORK.md "Surfaces"): rebuild it when the pushed change can reach it.
# A failure here doesn't undo the server ship; it's reported, and the next ship (or ag/build-mac) retries.
if ((PUSH && MAC)) && git diff --name-only "$BASE" "$SHA" | grep -E '^(apps/(web|desktop)|packages/|scripts/|pnpm-lock\.yaml|package\.json)' >/dev/null; then
	say "Mac app (ag/build-mac)"
	"$REPO/ag/build-mac" "$SHA" >&2 || say "Mac app build failed: the server is shipped; rerun ag/build-mac $SHORT"
fi
echo "shipped $VER  (https://ag.$(grep -m1 '^AG_TAILNET=' ~/ag-personal/env 2>/dev/null | cut -d= -f2 || echo '<tailnet>'))"
